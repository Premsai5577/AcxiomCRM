@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-task text-primary me-2"></i>Log Customer Activity</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold"></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold"></label>
                            <input asp-for="ActivityDate" class="form-control" type="date" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold"></label>
                            <input asp-for="Subject" class="form-control" placeholder="Brief subject line e.g. Technical Q&A with CTO" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- Associate Customer --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                                <option value="">-- Associate Lead --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Planned">Planned</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.AssignedTo">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Key takeaways, minutes of the meeting, next steps..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-check-circle me-1"></i> Log Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
