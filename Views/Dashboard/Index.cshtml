@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</h2>
        <span class="text-muted">Welcome back, <strong>@Model.UserName</strong> &bull; Scoped as <span class="badge bg-secondary">@Model.UserRole</span></span>
    </div>
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "All" ? "active" : "")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="month" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "month" ? "active" : "")">This Month</a>
        <a asp-action="Index" asp-route-dateFilter="week" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "week" ? "active" : "")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="today" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "today" ? "active" : "")">Today</a>
    </div>
</div>

<!-- Mandatory 8 KPI Cards (Page 17) -->
<div class="row g-3 mb-4">
    <!-- 1. Total Customers -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-primary h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Customers</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalCustomers</div>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted"><a asp-controller="Customer" asp-action="Index" class="text-decoration-none">View all customers &rarr;</a></div>
        </div>
    </div>

    <!-- 2. Total Leads -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-info h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Leads</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalLeads</div>
                </div>
                <div class="rounded-3 bg-info bg-opacity-10 p-3 text-info">
                    <i class="bi bi-person-lines-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted"><a asp-controller="Lead" asp-action="Index" class="text-decoration-none">View all leads &rarr;</a></div>
        </div>
    </div>

    <!-- 3. Open Leads -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-warning h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Open Leads</div>
                    <div class="fs-3 fw-bold text-warning">@Model.OpenLeads</div>
                </div>
                <div class="rounded-3 bg-warning bg-opacity-10 p-3 text-warning">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Active leads awaiting conversion</div>
        </div>
    </div>

    <!-- 4. Total Opportunities -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-secondary h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Opportunities</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalOpportunities</div>
                </div>
                <div class="rounded-3 bg-secondary bg-opacity-10 p-3 text-secondary">
                    <i class="bi bi-briefcase fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted"><a asp-controller="Opportunity" asp-action="Index" class="text-decoration-none">View all pipeline deals &rarr;</a></div>
        </div>
    </div>

    <!-- 5. Open Opportunities -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-primary h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Open Opportunities</div>
                    <div class="fs-3 fw-bold text-primary">@Model.OpenOpportunities</div>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-graph-up fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Active pipeline in progress</div>
        </div>
    </div>

    <!-- 6. Won Opportunities -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-success h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Won Opportunities</div>
                    <div class="fs-3 fw-bold text-success">@Model.WonOpportunities</div>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-trophy fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Successfully closed deals</div>
        </div>
    </div>

    <!-- 7. Lost Opportunities -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-danger h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Lost Opportunities</div>
                    <div class="fs-3 fw-bold text-danger">@Model.LostOpportunities</div>
                </div>
                <div class="rounded-3 bg-danger bg-opacity-10 p-3 text-danger">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Closed without conversion</div>
        </div>
    </div>

    <!-- 8. Total Pipeline Value -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card border-start border-4 border-success h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Pipeline Value</div>
                    <div class="fs-3 fw-bold text-dark">&#8377;@Model.TotalPipelineValue.ToString("N0")</div>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Weighted: &#8377;@Model.WeightedPipelineValue.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Mandatory Charts (Page 17: Chart.js) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status (New, Contacted, Qualified, Lost, Converted) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart me-1 text-primary"></i> Lead Status Distribution</h6>
                <small class="text-muted">By conversion stage</small>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline (Qualification, Proposal, Negotiation, Won, Lost) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart me-1 text-success"></i> Opportunity Pipeline by Stage</h6>
                <small class="text-muted">Total value (&#8377;) across stages</small>
            </div>
            <div class="card-body p-3" style="min-height: 280px;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up me-1 text-info"></i> Monthly Closed Won Deals</h6>
                <small class="text-muted">Revenue trends (Last 6 months)</small>
            </div>
            <div class="card-body p-3" style="min-height: 280px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Operational Lists: Upcoming Follow-ups & Recent Activities -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event text-primary me-2"></i>Upcoming Follow-Ups</h6>
                <a asp-controller="FollowUp" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Related To</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UpcomingFollowUps.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No upcoming follow-ups scheduled.</td></tr>
                        }
                        @foreach (var f in Model.UpcomingFollowUps)
                        {
                            <tr>
                                <td class="fw-semibold">@f.Subject</td>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpDate.ToString("dd MMM yyyy")</span></td>
                                <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                                <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                                <td>
                                    <form asp-controller="FollowUp" asp-action="MarkComplete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success btn-sm py-0" title="Complete"><i class="bi bi-check"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-activity text-success me-2"></i>Recent Activities</h6>
                <a asp-controller="Activity" asp-action="Create" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus"></i> Log Activity</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentActivities.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No recent activities logged.</td></tr>
                        }
                        @foreach (var a in Model.RecentActivities)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@a.ActivityType</span></td>
                                <td class="fw-semibold">@a.Subject</td>
                                <td class="small text-muted">@a.ActivityDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-success">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart 1: Lead Status
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts.Values)),
                    backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#dc3545', '#6f42c1']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Chart 2: Pipeline Stage Amounts
        const pipeCtx = document.getElementById('pipelineChart').getContext('2d');
        new Chart(pipeCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts.Keys)),
                datasets: [{
                    label: 'Pipeline Value (INR)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts.Values)),
                    backgroundColor: '#198754'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                },
                plugins: { legend: { display: false } }
            }
        });

        // Chart 3: Monthly Sales
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData.Keys)),
                datasets: [{
                    label: 'Won Deals Revenue (INR)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData.Values)),
                    borderColor: '#0284c7',
                    backgroundColor: 'rgba(2, 132, 199, 0.15)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
