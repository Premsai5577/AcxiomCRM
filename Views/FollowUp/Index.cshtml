@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Activities";
    var viewType = ViewData["ViewType"]?.ToString() ?? "all";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check text-primary me-2"></i>Follow-Up Management</h3>
        <span class="text-muted small">Stay on top of calls, meetings, emails, and client tasks</span>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group shadow-sm">
            <a asp-action="Index" asp-route-viewType="all" class="btn btn-outline-secondary btn-sm @(viewType == "all" ? "active" : "")">All</a>
            <a asp-action="Index" asp-route-viewType="upcoming" class="btn btn-outline-secondary btn-sm @(viewType == "upcoming" ? "active" : "")">Upcoming</a>
            <a asp-action="Index" asp-route-viewType="overdue" class="btn btn-outline-secondary btn-sm @(viewType == "overdue" ? "active" : "")">Overdue</a>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm"><i class="bi bi-plus-circle me-1"></i> Schedule Follow-Up</a>
    </div>
</div>

<!-- Search & Filter Card (Page 5 & 17) -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="viewType" value="@viewType" />
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Follow-Up Date</label>
                <input type="date" name="filterDate" value="@ViewData["FilterDate"]" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewData["StatusFilter"]?.ToString() == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewData["StatusFilter"]?.ToString() == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewData["StatusFilter"]?.ToString() == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewData["StatusFilter"]?.ToString() == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Assigned User</label>
                <select name="assignedFilter" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Up Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Follow-Up Date</th>
                    <th>Related Record</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No follow-ups found matching your selection.
                        </td>
                    </tr>
                }
                @foreach (var f in Model)
                {
                    var isPast = f.FollowUpDate.Date < DateTime.Today && f.Status == "Planned";
                    var statusBadge = f.Status switch
                    {
                        "Completed" => "bg-success",
                        "Planned" => isPast ? "bg-danger" : "bg-primary",
                        "Missed" => "bg-danger",
                        "Cancelled" => "bg-secondary",
                        _ => "bg-dark"
                    };

                    <tr>
                        <td class="fw-bold text-dark">@f.Subject</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @if (f.FollowUpType == "Call") { <i class="bi bi-telephone me-1 text-primary"></i> }
                                else if (f.FollowUpType == "Meeting") { <i class="bi bi-people me-1 text-success"></i> }
                                else if (f.FollowUpType == "Email") { <i class="bi bi-envelope me-1 text-info"></i> }
                                else { <i class="bi bi-check2-square me-1 text-secondary"></i> }
                                @f.FollowUpType
                            </span>
                        </td>
                        <td>
                            <span class="badge @(isPast ? "bg-danger-subtle text-danger border border-danger" : "bg-light text-dark border")">
                                <i class="bi bi-calendar3 me-1"></i>@f.FollowUpDate.ToString("dd MMM yyyy")
                                @if (isPast) { <strong class="ms-1">(Overdue)</strong> }
                            </span>
                        </td>
                        <td>
                            @if (f.Customer != null)
                            {
                                <span class="small"><i class="bi bi-person-badge text-primary"></i> @f.Customer.CustomerName</span>
                            }
                            else if (f.Lead != null)
                            {
                                <span class="small"><i class="bi bi-person-lines-fill text-info"></i> @f.Lead.LeadName</span>
                            }
                            else if (f.Opportunity != null)
                            {
                                <span class="small"><i class="bi bi-briefcase text-success"></i> @f.Opportunity.OpportunityName</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td><span class="badge @statusBadge">@f.Status</span></td>
                        <td><span class="small text-muted"><i class="bi bi-person"></i> @(f.AssignedUser?.FullName ?? "Unassigned")</span></td>
                        <td class="small text-muted text-truncate" style="max-width: 180px;">@(f.Remarks ?? "-")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (f.Status == "Planned")
                                {
                                    <form asp-action="MarkComplete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success" title="Mark as Completed"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@f.FollowUpId" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
