@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Follow-Up - @Model.Subject</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Subject" class="form-label fw-semibold"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="date" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold"></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.AssignedTo">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                            </div>
                        }

                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label fw-semibold small"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- Customer --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label fw-semibold small"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                                <option value="">-- Lead --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label fw-semibold small"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.OpportunityId">
                                <option value="">-- Opportunity --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label fw-semibold"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-save me-1"></i> Update Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
