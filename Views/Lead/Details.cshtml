@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Profile - " + Model.LeadName;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">@Model.LeadName</h3>
            <span class="badge @(Model.Status == "Converted" ? "bg-success" : (Model.Status == "Lost" ? "bg-danger" : "bg-primary"))">@Model.Status</span>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
        </div>
        <span class="text-muted small">Captured on @Model.LeadId &bull; Created @Model.CreatedDate.ToString("dd MMMM yyyy")</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm"><i class="bi bi-arrow-repeat me-1"></i> Convert to Customer</a>
        }
        else if (Model.CustomerId.HasValue)
        {
            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-success btn-sm"><i class="bi bi-box-arrow-up-right me-1"></i> View Converted Customer</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-info btn-sm text-dark"><i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-info me-2"></i>Lead Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Company:</dt>
                    <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-5 text-muted">Email:</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-5 text-muted">Phone:</dt>
                    <dd class="col-sm-7">@Model.Phone</dd>

                    <dt class="col-sm-5 text-muted">Lead Source:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@(Model.Source ?? "Website")</span></dd>

                    <dt class="col-sm-5 text-muted">Priority:</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.Priority == "High" ? "bg-danger" : (Model.Priority == "Medium" ? "bg-warning text-dark" : "bg-light text-dark border"))">
                            @Model.Priority
                        </span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Expected Value:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-6">&#8377;@Model.ExpectedValue.ToString("N0")</dd>

                    <dt class="col-sm-5 text-muted">Assigned To:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <!-- Linked Follow-Ups -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Scheduled Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i> New Follow-Up</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.FollowUps.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">No follow-ups recorded for this lead.</td></tr>
                        }
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td class="fw-semibold">@f.Subject</td>
                                <td>@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                                <td><span class="badge bg-light text-dark border">@f.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Linked Activities -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-success me-2"></i>Activity History (@Model.Activities.Count)</h6>
                <a asp-controller="Activity" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-success btn-sm"><i class="bi bi-plus"></i> Log Activity</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Activities.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">No activities logged yet.</td></tr>
                        }
                        @foreach (var a in Model.Activities)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@a.ActivityType</span></td>
                                <td class="fw-semibold">@a.Subject</td>
                                <td>@a.ActivityDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-success">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
