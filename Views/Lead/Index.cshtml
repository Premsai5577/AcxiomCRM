@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-person-lines-fill text-info me-2"></i>Leads</h3>
        <span class="text-muted small">Capture prospects, nurture opportunities, and convert deals</span>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm"><i class="bi bi-plus-circle me-1"></i> New Lead</a>
</div>

<!-- Search & Filter Card (Page 5 & 17) -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Lead Name</label>
                <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control form-control-sm" placeholder="Search name..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Company</label>
                <input type="text" name="searchCompany" value="@ViewData["SearchCompany"]" class="form-control form-control-sm" placeholder="Company..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewData["StatusFilter"]?.ToString() == "New")">New</option>
                    <option value="Contacted" selected="@(ViewData["StatusFilter"]?.ToString() == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewData["StatusFilter"]?.ToString() == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(ViewData["StatusFilter"]?.ToString() == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(ViewData["StatusFilter"]?.ToString() == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewData["StatusFilter"]?.ToString() == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Assigned User</label>
                <select name="assignedFilter" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Lead List Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Contact</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No leads found matching your criteria.
                        </td>
                    </tr>
                }
                @foreach (var l in Model)
                {
                    var statusBadge = l.Status switch
                    {
                        "New" => "bg-primary",
                        "Contacted" => "bg-info text-dark",
                        "Qualified" => "bg-warning text-dark",
                        "Converted" => "bg-success",
                        "Lost" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                        <td class="fw-bold text-dark">
                            <a asp-action="Details" asp-route-id="@l.LeadId" class="text-decoration-none">@l.LeadName</a>
                        </td>
                        <td class="small">
                            <div><i class="bi bi-envelope text-muted"></i> @l.Email</div>
                            <div><i class="bi bi-telephone text-muted"></i> @l.Phone</div>
                        </td>
                        <td>@(l.CompanyName ?? "-")</td>
                        <td><span class="badge bg-light text-secondary border">@(l.Source ?? "Direct")</span></td>
                        <td><span class="badge @statusBadge">@l.Status</span></td>
                        <td>
                            @if (l.Priority == "High")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger">High</span>
                            }
                            else if (l.Priority == "Medium")
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning">Medium</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Low</span>
                            }
                        </td>
                        <td class="fw-bold">&#8377;@l.ExpectedValue.ToString("N0")</td>
                        <td><span class="small text-muted"><i class="bi bi-person"></i> @(l.AssignedUser?.FullName ?? "Unassigned")</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                @if (l.Status != "Converted")
                                {
                                    <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer"><i class="bi bi-arrow-repeat"></i></a>
                                }
                                <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@l.LeadId" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
