@model AcxiomCRM.ViewModels.ConvertLeadViewModel
@{
    ViewData["Title"] = "Convert Lead - " + Model.LeadName;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-arrow-repeat me-2"></i>Convert Lead to Customer & Deal</h5>
                <small class="text-white-50">Lead Code: @Model.LeadCode &bull; Prospect: @Model.LeadName</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="ExpectedValue" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Customer Creation Section -->
                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="CreateCustomer" class="form-check-input" type="checkbox" id="chkCreateCustomer" checked />
                            <label class="form-check-label fw-bold text-dark" for="chkCreateCustomer">Create Customer Record in Master Directory</label>
                        </div>
                        <div class="row g-3 mt-1" id="customerFields">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-semibold small"></label>
                                <input asp-for="CustomerName" class="form-control form-control-sm" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Email Address</label>
                                <input type="text" class="form-control form-control-sm" value="@Model.Email" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Phone</label>
                                <input type="text" class="form-control form-control-sm" value="@Model.Phone" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-semibold small"></label>
                                <input asp-for="Address" class="form-control form-control-sm" placeholder="Street Address" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-semibold small"></label>
                                <input asp-for="City" class="form-control form-control-sm" placeholder="City" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="State" class="form-label fw-semibold small"></label>
                                <input asp-for="State" class="form-control form-control-sm" placeholder="State" />
                            </div>
                        </div>
                    </div>

                    <!-- Opportunity Creation Section -->
                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="chkCreateOpportunity" checked />
                            <label class="form-check-label fw-bold text-dark" for="chkCreateOpportunity">Create Associated Pipeline Deal / Opportunity</label>
                        </div>
                        <div class="row g-3 mt-1" id="opportunityFields">
                            <div class="col-md-6">
                                <label asp-for="OpportunityName" class="form-label fw-semibold small"></label>
                                <input asp-for="OpportunityName" class="form-control form-control-sm" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold small"></label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">&#8377;</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpportunityStage" class="form-label fw-semibold small"></label>
                                <select asp-for="OpportunityStage" class="form-select form-select-sm">
                                    <option value="Qualification">Qualification</option>
                                    <option value="Proposal">Proposal</option>
                                    <option value="Negotiation">Negotiation</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpportunityProbability" class="form-label fw-semibold small"></label>
                                <input asp-for="OpportunityProbability" class="form-control form-control-sm" type="number" min="0" max="100" />
                                <span asp-validation-for="OpportunityProbability" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small"></label>
                                <input asp-for="ExpectedCloseDate" class="form-control form-control-sm" type="date" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold"><i class="bi bi-check2-circle me-1"></i> Complete Conversion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
