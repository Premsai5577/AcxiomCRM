@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger shadow-sm">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error Details:</h5>
        <p class="mb-0">@Model.ErrorMessage</p>
    </div>
}

@if (!string.IsNullOrEmpty(Model.StackTrace))
{
    <details class="mt-3">
        <summary class="btn btn-outline-secondary btn-sm">View Technical Stack Trace</summary>
        <pre class="bg-dark text-white p-3 rounded mt-2" style="font-size: 0.8rem; overflow-x: auto;">@Model.StackTrace</pre>
    </details>
}
