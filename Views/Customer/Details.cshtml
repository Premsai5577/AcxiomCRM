@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Profile - " + Model.CustomerName;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">@Model.CustomerName</h3>
            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
            <span class="badge bg-light text-dark border">@Model.CustomerCode</span>
        </div>
        <span class="text-muted small">Registered on @Model.CreatedDate.ToString("dd MMMM yyyy") by @(Model.CreatedBy ?? "System")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-success btn-sm"><i class="bi bi-plus-circle me-1"></i> Add Opportunity</a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-info btn-sm text-dark"><i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Contact Info Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Contact Details</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Company:</dt>
                    <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-5 text-muted">Email:</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-5 text-muted">Phone:</dt>
                    <dd class="col-sm-7">@Model.Phone</dd>

                    <dt class="col-sm-5 text-muted">Address:</dt>
                    <dd class="col-sm-7">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-5 text-muted">City / State:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrEmpty(Model.City) ? $"{Model.City}, {Model.State}" : "-")</dd>

                    <dt class="col-sm-5 text-muted">Assigned Rep:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-person me-1"></i>@(Model.AssignedUser?.FullName ?? "Unassigned")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Related Opportunities -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-success me-2"></i>Linked Sales Deals (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm"><i class="bi bi-plus"></i> New Deal</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Deal Name</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Expected Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Opportunities.Any())
                        {
                            <tr><td colspan="5" class="text-center py-3 text-muted">No deals currently linked.</td></tr>
                        }
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td><a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">@opp.OpportunityName</a></td>
                                <td class="fw-bold">&#8377;@opp.Amount.ToString("N0")</td>
                                <td><span class="badge bg-secondary">@opp.Stage</span></td>
                                <td>@opp.Probability%</td>
                                <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Follow-Ups and Activities Tabs -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <ul class="nav nav-tabs card-header-tabs" id="customerTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab"><i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab"><i class="bi bi-activity me-1"></i> Activity History (@Model.Activities.Count)</button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content p-3" id="customerTabContent">
                <div class="tab-pane fade show active" id="followups" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.FollowUps.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-2">No follow-ups recorded.</td></tr>
                                }
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-semibold">@f.Subject</td>
                                        <td>@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                                        <td><span class="badge bg-light text-dark border">@f.Status</span></td>
                                        <td class="small text-muted">@(f.Remarks ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="activities" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Activities.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-2">No activity history recorded.</td></tr>
                                }
                                @foreach (var a in Model.Activities)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@a.ActivityType</span></td>
                                        <td class="fw-semibold">@a.Subject</td>
                                        <td>@a.ActivityDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-success">@a.Status</span></td>
                                        <td class="small text-muted">@(a.Description ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
