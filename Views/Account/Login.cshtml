@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In to AcxiomCRM</h4>
                <small class="text-white-50">Enterprise Customer Relationship Management</small>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>

                    <div class="text-center mt-3">
                        <span class="text-muted small">Don't have an account?</span>
                        <a asp-action="Register" class="text-decoration-none fw-semibold small">Register here</a>
                    </div>
                </form>

                <hr class="my-4" />

                <!-- Quick Test Credentials Box -->
                <div class="bg-light p-3 rounded-2 border">
                    <h6 class="fw-bold mb-2 text-dark small"><i class="bi bi-lightning-charge-fill text-warning"></i> Demo / Test Credentials:</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <button type="button" class="btn btn-sm btn-outline-danger text-start" onclick="fillCreds('admin@acxiomcrm.com', 'Admin@123')">
                            <strong>Admin:</strong> admin@acxiomcrm.com / Admin@123
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark text-start" onclick="fillCreds('manager@acxiomcrm.com', 'Manager@123')">
                            <strong>Manager:</strong> manager@acxiomcrm.com / Manager@123
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-dark text-start" onclick="fillCreds('sales@acxiomcrm.com', 'Sales@123')">
                            <strong>Sales Executive:</strong> sales@acxiomcrm.com / Sales@123
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, pwd) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pwd;
        }
    </script>
}
