@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5 rounded-3">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x fs-1" style="font-size: 4rem !important;"></i>
            </div>
            <h2 class="fw-bold text-danger">Access Denied</h2>
            <p class="text-muted mt-2">You do not have permission to access this resource or administrative area.</p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-speedometer2 me-1"></i> Return to Dashboard</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Home</a>
            </div>
        </div>
    </div>
</div>
