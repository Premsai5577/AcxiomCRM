@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-success me-2"></i>New Opportunity Entry</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="oppForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="Enterprise ERP Expansion" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                                <option value="">-- Optional Associated Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                <input asp-for="Amount" class="form-control" type="number" min="0.01" step="1000" id="oppAmount" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small" id="amountError"></span>
                            <div class="form-text small">Must be greater than 0.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold"></label>
                            <select asp-for="Stage" class="form-select" id="oppStage">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="oppProbability" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small" id="probError"></span>
                            <div class="form-text small">Range 0 to 100.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@minDate" id="closeDateInput" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small" id="dateError"></span>
                            <div class="form-text small">Cannot be in the past for active deals.</div>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.AssignedTo">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key deal terms, customer requirements, decision timeline..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-check-circle me-1"></i> Save Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('oppForm').addEventListener('submit', function (e) {
            let valid = true;
            const amt = parseFloat(document.getElementById('oppAmount').value);
            const prob = parseInt(document.getElementById('oppProbability').value);
            const closeDate = new Date(document.getElementById('closeDateInput').value);
            const stage = document.getElementById('oppStage').value;
            const today = new Date();
            today.setHours(0,0,0,0);

            if (isNaN(amt) || amt <= 0) {
                document.getElementById('amountError').textContent = 'Opportunity Amount must be greater than 0.';
                valid = false;
            } else {
                document.getElementById('amountError').textContent = '';
            }

            if (isNaN(prob) || prob < 0 || prob > 100) {
                document.getElementById('probError').textContent = 'Probability must be between 0 and 100.';
                valid = false;
            } else {
                document.getElementById('probError').textContent = '';
            }

            if (stage !== 'Won' && stage !== 'Lost' && closeDate < today) {
                document.getElementById('dateError').textContent = 'Expected Close Date cannot be in the past.';
                valid = false;
            } else {
                document.getElementById('dateError').textContent = '';
            }

            if (!valid) {
                e.preventDefault();
            }
        });
    </script>
}
