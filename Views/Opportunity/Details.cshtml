@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details - " + Model.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">@Model.OpportunityName</h3>
            <span class="badge @(Model.Status == "Won" ? "bg-success" : (Model.Status == "Lost" ? "bg-danger" : "bg-primary"))">@Model.Status</span>
            <span class="badge bg-secondary">@Model.Stage</span>
        </div>
        <span class="text-muted small">Created on @Model.CreatedDate.ToString("dd MMMM yyyy")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-oppId="@Model.OpportunityId" class="btn btn-info btn-sm text-dark"><i class="bi bi-calendar-plus me-1"></i> Add Follow-Up</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Pipeline</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase text-success me-2"></i>Deal Summary</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Customer:</dt>
                    <dd class="col-sm-7 fw-semibold">
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-decoration-none">@Model.Customer.CustomerName</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">Deal Amount:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">&#8377;@Model.Amount.ToString("N0")</dd>

                    <dt class="col-sm-5 text-muted">Win Probability:</dt>
                    <dd class="col-sm-7">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: @Model.Probability%;"></div>
                            </div>
                            <span class="fw-semibold">@Model.Probability%</span>
                        </div>
                    </dd>

                    <dt class="col-sm-5 text-muted">Weighted Forecast:</dt>
                    <dd class="col-sm-7 fw-bold text-primary">&#8377;@Model.WeightedPipeline.ToString("N0")</dd>

                    <dt class="col-sm-5 text-muted">Expected Close Date:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.ExpectedCloseDate.ToString("dd MMMM yyyy")</span></dd>

                    <dt class="col-sm-5 text-muted">Assigned Owner:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Notes:</dt>
                    <dd class="col-sm-7 text-muted">@(Model.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Scheduled Deal Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-oppId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i> Add</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.FollowUps.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups scheduled for this opportunity.</td></tr>
                        }
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td class="fw-semibold">@f.Subject</td>
                                <td>@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                                <td><span class="badge bg-light text-dark border">@f.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
