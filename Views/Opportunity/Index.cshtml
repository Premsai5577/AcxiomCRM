@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
    var totalPipeline = Model.Where(o => o.Stage != "Lost").Sum(o => o.Amount);
    var weightedPipeline = Model.Where(o => o.Stage != "Lost").Sum(o => o.WeightedPipeline);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Sales Opportunities</h3>
        <span class="text-muted small">Total Pipeline: <strong class="text-success">&#8377;@totalPipeline.ToString("N0")</strong> &bull; Weighted Forecast: <strong class="text-primary">&#8377;@weightedPipeline.ToString("N0")</strong></span>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm"><i class="bi bi-plus-circle me-1"></i> New Opportunity</a>
</div>

<!-- Search & Filter Card (Page 5 & 17) -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Opportunity Name</label>
                <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control form-control-sm" placeholder="Search deal..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Customer</label>
                <select name="customerFilter" class="form-select form-select-sm" asp-items="ViewBag.CustomerList">
                    <option value="">All Customers</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Stage</label>
                <select name="stageFilter" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewData["StageFilter"]?.ToString() == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewData["StageFilter"]?.ToString() == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewData["StageFilter"]?.ToString() == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewData["StageFilter"]?.ToString() == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewData["StageFilter"]?.ToString() == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(ViewData["StatusFilter"]?.ToString() == "Open")">Open</option>
                    <option value="Won" selected="@(ViewData["StatusFilter"]?.ToString() == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewData["StatusFilter"]?.ToString() == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Opportunity Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No opportunities found matching your filters.
                        </td>
                    </tr>
                }
                @foreach (var o in Model)
                {
                    var stageBadge = o.Stage switch
                    {
                        "Qualification" => "bg-secondary",
                        "Proposal" => "bg-info text-dark",
                        "Negotiation" => "bg-warning text-dark",
                        "Won" => "bg-success",
                        "Lost" => "bg-danger",
                        _ => "bg-dark"
                    };

                    <tr>
                        <td class="fw-bold text-dark">
                            <a asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">@o.OpportunityName</a>
                        </td>
                        <td>@(o.Customer?.CustomerName ?? "-")</td>
                        <td class="fw-bold text-success fs-6">&#8377;@o.Amount.ToString("N0")</td>
                        <td><span class="badge @stageBadge">@o.Stage</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @o.Probability%;"></div>
                                </div>
                                <span class="small">@o.Probability%</span>
                            </div>
                        </td>
                        <td class="fw-semibold text-muted">&#8377;@o.WeightedPipeline.ToString("N0")</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar3 me-1"></i>@o.ExpectedCloseDate.ToString("dd MMM yyyy")
                            </span>
                        </td>
                        <td><span class="small text-muted"><i class="bi bi-person"></i> @(o.AssignedUser?.FullName ?? "Unassigned")</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@o.OpportunityId" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
