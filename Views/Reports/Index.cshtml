@model AcxiomCRM.ViewModels.ReportSummaryViewModel
@{
    ViewData["Title"] = "CRM Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart text-primary me-2"></i>Reports & Intelligence</h3>
        <span class="text-muted small">Comprehensive sales performance, conversion metrics, and operational audits</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print / Export</button>
    </div>
</div>

<!-- Report Navigation Tabs -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-3 shadow-sm flex-wrap gap-1">
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "Pipeline" ? "active" : "")" asp-action="Index" asp-route-reportType="Pipeline">
            <i class="bi bi-graph-up-arrow me-1"></i> Pipeline Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "Conversion" ? "active" : "")" asp-action="Index" asp-route-reportType="Conversion">
            <i class="bi bi-arrow-repeat me-1"></i> Conversion Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "Customer" ? "active" : "")" asp-action="Index" asp-route-reportType="Customer">
            <i class="bi bi-people me-1"></i> Customer Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "Lead" ? "active" : "")" asp-action="Index" asp-route-reportType="Lead">
            <i class="bi bi-person-lines-fill me-1"></i> Lead Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "FollowUp" ? "active" : "")" asp-action="Index" asp-route-reportType="FollowUp">
            <i class="bi bi-calendar-check me-1"></i> Follow-Up Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ReportType == "Opportunity" ? "active" : "")" asp-action="Index" asp-route-reportType="Opportunity">
            <i class="bi bi-briefcase me-1"></i> Opportunity Report
        </a>
    </li>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ReportType == "UserActivity" ? "active" : "")" asp-action="Index" asp-route-reportType="UserActivity">
                <i class="bi bi-activity me-1"></i> User Activity
            </a>
        </li>
    }
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ReportType == "Audit" ? "active" : "")" asp-action="Index" asp-route-reportType="Audit">
                <i class="bi bi-journal-text me-1"></i> Audit Report
            </a>
        </li>
    }
</ul>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="reportType" value="@Model.ReportType" />
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Start Date</label>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">End Date</label>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Assigned User</label>
                <select name="selectedUser" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-filter"></i> Run Report</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Content by Type -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">
        @if (Model.ReportType.Equals("Pipeline", StringComparison.OrdinalIgnoreCase))
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Total Pipeline Value</div>
                        <div class="fs-4 fw-bold text-success">&#8377;@Model.TotalPipeline.ToString("N0")</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Weighted Pipeline Forecast</div>
                        <div class="fs-4 fw-bold text-primary">&#8377;@Model.WeightedPipeline.ToString("N0")</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Total Deals Analyzed</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Opportunities.Count</div>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-3">Stage-Wise Pipeline Breakdown</h6>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Pipeline Stage</th>
                            <th>Total Deal Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model.StageBreakdown)
                        {
                            <tr>
                                <td class="fw-semibold">@stage.Key</td>
                                <td class="fw-bold text-success">&#8377;@stage.Value.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h6 class="fw-bold text-dark mb-3">Detailed Deal Opportunities</h6>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                            <th>Owner</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-bold">@opp.OpportunityName</td>
                                <td>@(opp.Customer?.CustomerName ?? "-")</td>
                                <td class="fw-bold text-success">&#8377;@opp.Amount.ToString("N0")</td>
                                <td><span class="badge bg-secondary">@opp.Stage</span></td>
                                <td>@opp.Probability%</td>
                                <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td>@(opp.AssignedUser?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("Conversion", StringComparison.OrdinalIgnoreCase))
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Total Leads Captured</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalLeadsCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Successfully Converted</div>
                        <div class="fs-4 fw-bold text-success">@Model.ConvertedLeadsCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Conversion Rate</div>
                        <div class="fs-4 fw-bold text-primary">@Model.ConversionRate.ToString("F1")%</div>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-3">Lead Status Distribution</h6>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Lead Status</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StatusBreakdown)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Key</td>
                                <td class="fw-bold">@s.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("Customer", StringComparison.OrdinalIgnoreCase))
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                                <td class="fw-bold">@c.CustomerName</td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td>@(c.CompanyName ?? "-")</td>
                                <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                                <td>@(c.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("Lead", StringComparison.OrdinalIgnoreCase))
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Email</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Expected Value</th>
                            <th>Assigned To</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                                <td class="fw-bold">@l.LeadName</td>
                                <td>@l.Email</td>
                                <td>@(l.Source ?? "Direct")</td>
                                <td><span class="badge bg-primary">@l.Status</span></td>
                                <td>@l.Priority</td>
                                <td class="fw-bold text-success">&#8377;@l.ExpectedValue.ToString("N0")</td>
                                <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td>@l.CreatedDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("FollowUp", StringComparison.OrdinalIgnoreCase))
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Related To</th>
                            <th>Assigned To</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td class="fw-bold">@f.Subject</td>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td>@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-secondary">@f.Status</span></td>
                                <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                                <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="small text-muted">@(f.Remarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("Opportunity", StringComparison.OrdinalIgnoreCase))
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Opportunity Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                            <th>Assigned To</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-bold">@o.OpportunityName</td>
                                <td>@(o.Customer?.CustomerName ?? "-")</td>
                                <td><span class="badge bg-secondary">@o.Stage</span></td>
                                <td class="fw-bold text-success">&#8377;@o.Amount.ToString("N0")</td>
                                <td>@o.Probability%</td>
                                <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("UserActivity", StringComparison.OrdinalIgnoreCase))
        {
            <h6 class="fw-bold text-dark mb-3">User Action Counts</h6>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Team Member</th>
                            <th>Activities Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UserActivityCounts)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Key</td>
                                <td class="fw-bold text-primary">@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ReportType.Equals("Audit", StringComparison.OrdinalIgnoreCase))
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm font-monospace small align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Record ID</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.AuditLogs)
                        {
                            <tr>
                                <td>@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(log.UserName ?? "System")</td>
                                <td><span class="badge bg-dark">@log.Action</span></td>
                                <td>@log.EntityName</td>
                                <td>@(log.RecordId ?? "-")</td>
                                <td>@(log.Details ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
